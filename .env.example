# Namuna fayl — qiymatlarni .env ga yozing (bu fayl git'ga qo'shiladi, qiymatsiz)
# Lokalda: shu faylni nusxalab .env yarating va qiymatlarni to'ldiring
# Render'da: bu kalitlarni Environment bo'limida o'rnating

SECRET_KEY=
DEBUG=False
DATABASE_URL=

# Telegram bot tokeni (@BotFather'dan)
TG_BOT_TOKEN=

# Bot username (@siz) — panelda "botga kiring" havolasi uchun
TG_BOT_USERNAME=

# Backend'ning tashqi https manzili. Webhook shu bo'yicha o'rnatiladi —
# bo'sh qolsa bot update qabul qilmaydi va umuman javob bermaydi.
# Masalan: https://itline-django-9s85.onrender.com
PUBLIC_BASE_URL=

# Webhook maxfiy kaliti — soxta so'rovlarni rad etadi (ixtiyoriy, tavsiya etiladi)
TG_WEBHOOK_SECRET=

# Admin va menejer panel parollari
ADMIN_PASSWORD=
EXCELLENCE_PASSWORD=

# Menejer panel manzili — Telegram lead xabaridagi "Bazaga qo'shish"
# tugmasi shu yerga /add-student ochadi (bo'sh bo'lsa tugma chiqmaydi)
PANEL_BASE_URL=https://crmfr.vercel.app
